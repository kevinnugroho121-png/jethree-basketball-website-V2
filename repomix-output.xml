                            <span class="px-3 py-1.5 text-xs text-gray-400">...</span>
                        @endif
                    @endif

                    {{-- Menampilkan Range Halaman di Tengah --}}
                    @foreach ($atlets->appends(request()->query())->getUrlRange($startPage, $endPage) as $page => $url)
